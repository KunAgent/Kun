{
    "workflow_name": "daily_report",
    "description": "Steam平台日报数据收集和分析",
    "steps": [
        {
            "step_id": 0,
            "step_name": "game_daily_update",
            "description": "游戏更新和新闻收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "news.views"
                                ],
                                "dimensions": [
                                    "news.title",
                                    "news.content"
                                ],
                                "timeDimensions": [
                                    {
                                        "dimension": "news.date",
                                        "dateRange": [
                                            "{start_time}",
                                            "{end_time}"
                                        ]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "news.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ],
                                "order": {
                                    "news.views": "desc"
                                },
                                "limit": 5
                            }
                        }
                    },
                    "expected_output": "游戏新闻",
                    "metrics_collected": [
                        "News"
                    ]
                }
            ]
        },
        {
            "step_id": 1,
            "step_name": "steam_overview_period",
            "description": "Steam平台选定时间Overview",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.game_store_reviews",
                                    "feeds.steam_recommend_mentions",
                                    "feeds.steam_unrecommend_mentions",
                                    "feeds.steam_recommend_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "dateRange": [
                                            "{start_time}",
                                            "{end_time}"
                                        ]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "Steam平台选定时间Overview",
                    "metrics_collected": [
                        "Total Reviews - 24H",
                        "Positive Reviews - 24H",
                        "Negative Reviews - 24H",
                        "Positive Rate - 24H"
                    ]
                }
            ]
        },
        {
            "step_id": 2,
            "step_name": "steam_overview_lifetime",
            "description": "Steam平台生命周期概览",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "steam_score.all_reviews_count",
                                    "steam_score.positive_reviews_count",
                                    "steam_score.all_reviews_positive_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "steam_score.date",
                                        "granularity": "day",
                                        "dateRange": [
                                            "{end_time}",
                                            "{end_time}"
                                        ]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "steam_score.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "Steam 生命周期概览数据",
                    "metrics_collected": [
                        "Total Reviews - Lifetime",
                        "Positive Reviews - Lifetime",
                        "Negative Reviews - Lifetime (calculated: all_reviews_count - positive_reviews_count)",
                        "Positive Rate - Lifetime"
                    ]
                }
            ]
        },
        {
            "step_id": 3,
            "step_name": "steam_overview_by_hours",
            "description": "Steam平台按小时数据",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.steam_recommend_mentions",
                                    "feeds.steam_unrecommend_mentions",
                                    "feeds.steam_recommend_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "granularity": "hour",
                                        "dateRange": [
                                            "{start_time}",
                                            "{end_time}"
                                        ]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "Steam平台按小时数据",
                    "metrics_collected": [
                        "Recommend Reviews - By Hours 24 hours",
                        "Unrecommend Reviews - By Hours 24 hours",
                        "Recommend Rate - By Hours 24 hours"
                    ]
                }
            ]
        },       
        {            
            "step_id": 4,
            "step_name": "steam_overview_by_day",
            "description": "Steam平台14天按天数据收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.steam_recommend_mentions",
                                    "feeds.steam_unrecommend_mentions",
                                    "feeds.steam_recommend_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "granularity": "day",
                                        "dateRange": ["请计算{end_time}-14天", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "Steam平台14天数据",
                    "metrics_collected": [
                        "Positive Reviews - By Day 14 days",
                        "Negative Reviews - By Day 14 days",
                        "Positive Rate - By Day 14 days"
                    ]
                }
            ]
        },
        {
            "step_id": 5,
            "step_name": "steam_reviews_topics",
            "description": "Steam平台评论话题分析",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "opinion_summary_tool",
                        "arguments": {
                            "start_time": "{start_time}",
                            "end_time": "{end_time}",
                            "sentiment_type": "total",
                            "channel_type": "game_store",
                            "date_type": "daily",
                            "edition_unified_id": "{game_id}",
                            "entity_type": "pc",
                            "id_type": "edition_id"
                        }
                    },
                    "expected_output": "Steam 评论话题分析",
                    "metrics_collected": [
                        "Topic Summary - By Topics",
                        "number of reviews - By Topics",
                        "percentage - By Topics"
                    ]
                }
            ]
        },
        {
            "step_id": 6,
            "step_name": "steam_by_language",
            "description": "Steam平台按语言分类数据收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.game_store_reviews",
                                    "feeds.steam_recommend_mentions",
                                    "feeds.steam_unrecommend_mentions",
                                    "feeds.steam_recommend_rate"
                                ],
                                "dimensions": [
                                    "feeds.language_en"
                                ],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "granularity": "day",
                                        "dateRange": ["{start_time}", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "Steam 按语言分类数据",
                    "metrics_collected": [
                        "Total Reviews - Period - By Language",
                        "Positive Reviews - Period - By Language",
                        "Negative Reviews - Period - By Language",
                        "Positive Rate - Period - By Language"
                    ]
                }
            ]
        },
        {
            "step_id": 8,
            "step_name": "social_media_period",
            "description": "社交媒体所选时间数据",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.mentions",
                                    "feeds.avg_sentiment",
                                    "feeds.positive_rate",
                                    "feeds.negative_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "dateRange": ["{start_time}", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "社交媒体所选时间数据",
                    "metrics_collected": [
                        "Mentions",
                        "Sentiment",
                        "Positive Rate",
                        "Negative Rate"
                    ]
                }
            ]
        },
        {
            "step_id": 9,
            "step_name": "social_media_lifetime",
            "description": "社交媒体14天生命周期数据收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.mentions",
                                    "feeds.avg_sentiment",
                                    "feeds.positive_rate",
                                    "feeds.negative_rate"
                                ],
                                "dimensions": [],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "granularity": "day",
                                        "dateRange": ["请计算{end_time}-14天", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "社交媒体14天生命周期数据",
                    "metrics_collected": [
                        "Mentions - 14 days",
                        "Sentiment - 14 days",
                        "Positive Rate - 14 days",
                        "Negative Rate - 14 days"
                    ]
                }
            ]
        },
        {
            "step_id": 10,
            "step_name": "social_media_reviews_topics",
            "description": "社交媒体评论话题分析",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "opinion_summary_tool",
                        "arguments": {
                            "start_time": "{start_time}",
                            "end_time": "{end_time}",
                            "sentiment_type": "total",
                            "channel_type": "social",
                            "date_type": "daily",
                            "edition_unified_id": "{game_id}",
                            "entity_type": "pc",
                            "id_type": "edition_id"
                        }
                    },
                    "expected_output": "社交媒体评论话题分析",
                    "metrics_collected": [
                        "Topic Summary - By Topics",
                        "number of reviews - By Topics",
                        "percentage - By Topics"
                    ]
                }
            ]
        },
        {
            "step_id": 11,
            "step_name": "community_channel",
            "description": "社区按渠道分类数据收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.mentions",
                                    "feeds.avg_sentiment",
                                    "feeds.positive_rate",
                                    "feeds.negative_rate"
                                ],
                                "dimensions": [
                                    "feeds.channel_display_name"
                                ],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "dateRange": ["{start_time}", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "社区按渠道分类数据",
                    "metrics_collected": [
                        "Mentions - Period By Channel",
                        "Sentiment - Period By Channel",
                        "Positive Rate - Period By Channel",
                        "Negative Rate - Period By Channel"
                    ]
                }
            ]
        },
        {
            "step_id": 12,
            "step_name": "community_language",
            "description": "社区按语言分类数据收集",
            "agent": "Opinions Agent",
            "tool_calls": [
                {
                    "function": {
                        "name": "read_data",
                        "arguments": {
                            "query": {
                                "measures": [
                                    "feeds.mentions",
                                    "feeds.avg_sentiment",
                                    "feeds.positive_rate",
                                    "feeds.negative_rate"
                                ],
                                "dimensions": [
                                    "feeds.language_en"
                                ],
                                "timeDimensions": [
                                    {
                                        "dimension": "feeds.date",
                                        "dateRange": ["{start_time}", "{end_time}"]
                                    }
                                ],
                                "filters": [
                                    {
                                        "member": "feeds.game_id",
                                        "operator": "equals",
                                        "values": [
                                            "{game_id}"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    "expected_output": "社区按语言分类数据",
                    "metrics_collected": [
