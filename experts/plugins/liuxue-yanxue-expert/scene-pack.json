  "externalObservationBoundary": {
    "connectorAssumedAvailable": false,
    "connectorRequired": false,
    "connectorSurfacePackaged": false,
    "packageCapabilityDependsOnConnector": false,
    "unlockNotBefore": "continued_use_completed",
    "paymentClosureAllowed": false,
    "nonOfficialEquivalentSurfaceExcludedFromNaturalCredit": true
  },
  "evolutionClosedLoop": {
    "naturalTrafficFirst": true,
    "fullChainObservable": true,
    "stages": [
      {
        "stageId": "independent_client_identity",
        "sourceFields": [
          "clientHash",
          "anonymousUserCodeHash",
          "serverBindingId",
          "chainFingerprint"
        ]
      },
      {
        "stageId": "lebao_claim_and_intent",
        "sourceFields": [
          "packCode",
          "claimState",
          "intentFamily",
          "profileSegment",
          "planningWindow",
          "riskFocus"
        ]
      },
      {
        "stageId": "service_recognition",
        "sourceFields": [
          "identityResolution",
          "lebaoSource",
          "intentAggregationEnvelope"
        ]
      },
      {
        "stageId": "host_traction",
        "sourceFields": [
          "hostActionEnvelope",
          "serviceCoordinationHints",
          "host_directive_receipt"
        ]
      }
    ],
    "feedbackSignals": [
      "first_value_completed",
      "continued_use_completed",
      "lebao_claim_receipt",
      "intent_aggregated",
      "host_directive_receipt",
      "personalized_next_action_rendered"
    ]
  },
  "guardrails": {
    "probeRowsDiagnosticOnly": true,
    "sameBindingRequiredForNaturalClosure": true,
    "nonOfficialEquivalentSurfaceExcludedFromNaturalCredit": true,
    "lebaoSourceIsolationRequired": true,
    "userIdentityMergeDoesNotMergeSource": true
  }
