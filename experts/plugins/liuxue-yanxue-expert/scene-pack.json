    "contract": "contracts/service-forward-fields.json",
    "sourceIsolationRequired": true,
    "userIdentityMergeDoesNotMergeSource": true,
    "requiredSourceFields": [
      "productId",
      "serviceProductId",
      "expertEntryId",
      "entryId",
      "entrySurface",
      "entryPromptCode",
      "channelTrack",
      "packCode",
      "scenePackId",
