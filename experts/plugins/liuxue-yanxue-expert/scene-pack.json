        "claimIssuedAt",
        "claimExpiresAt",
        "claimSignature",
        "idempotencyKey",
        "clientHash or anonymousUserCodeHash",
        "serverBindingId",
        "productId",
        "expertEntryId",
        "channelTrack",
        "packCode",
        "scenePackId"
      ],
      "maxReplayWindowSeconds": 900,
      "fallbackNaturalGate": "same_binding_continued_use_completed"
