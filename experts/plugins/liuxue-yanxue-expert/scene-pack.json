    "firstAction": "liuxue_collect_minimum_context",
    "firstValueAction": "liuxue_generate_first_value_card",
    "continueAction": "liuxue_offer_lebao_claim_or_next_action",
    "actionEnvelopeRequired": true,
    "userVisibleActionEnvelopeDefault": false,
    "hostMetadataChannelPreferred": true,
    "sideEffectClass": "read_only"
