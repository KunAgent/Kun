  },
  "identityResolution": {
    "schemaVersion": "fbss.desensitizedIdentityResolution.v1",
    "subject": "independent_client",
    "identityCanMergeAcrossProducts": true,
    "lebaoSourceMustRemainSeparated": true,
    "allowedFields": [
      "clientHash",
      "installHash",
      "hostClientIdHash",
      "anonymousUserCodeHash",
      "serverBindingId",
      "sessionBindingId",
      "chainFingerprint",
      "platform",
      "hostVersion",
      "packageVersion"
    ],
    "forbiddenFields": [
      "phone",
      "email",
      "idCard",
      "passportNo",
      "realName",
      "rawDeviceId",
      "rawIp"
    ]
  },
  "noConnectorActionContract": {
