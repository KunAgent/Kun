{
  "name": "kun",
  "version": "0.1.0",
  "description": "Kun local HTTP/SSE agent runtime",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "import": "./dist/loop/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "bin": {
    "kun": "./dist/cli/serve-entry.js",
    "kun-dv": "./dist/cli/serve-entry.js"
  },
  "scripts": {
    "build": "node ./scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node ./scripts/write-runtime-build-manifest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test ./scripts/runtime-build-manifest.test.mjs && node ./scripts/run-tests.mjs",
    "test:memory-growth": "node ./scripts/run-memory-growth-regression.mjs",
    "test:watch": "vitest",
    "transcript:diff": "node ./scripts/transcript-diff.mjs",
    "benchmark:replay": "npm run build && node ./dist/cli/replay-entry.js",
    "serve": "node ./dist/cli/serve-entry.js",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@computer-use/nut-js": "^4.2.0",
    "@cursor/sdk": "1.0.24",
    "@earendil-works/pi-tui": "0.81.1",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@google/gemini-cli": "0.53.0",
    "@kun/extension-api": "file:../packages/extension-api",
    "@kun/provider-catalog": "file:../packages/provider-catalog",
    "@modelcontextprotocol/client": "^2.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.10.0",
    "create-kun-extension": "file:../packages/create-kun-extension",
    "diff": "^8.0.4",
    "highlight.js": "^11.11.1",
    "ipaddr.js": "^2.4.0",
    "jimp": "^1.6.0",
    "pdfjs-dist": "5.4.394",
    "proxy-agent": "^8.0.2",
    "safe-regex2": "5.1.1",
    "semver": "^7.8.5",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "undici": "^7.29.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.5",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "@connectrpc/connect-node": {
      "undici": "6.28.0"
    }
  }
}
