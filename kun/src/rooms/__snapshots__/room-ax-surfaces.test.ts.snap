exports[`room agent-visible surface registry > renders room.rule-compression-prompt :: default 1`] = `
"Compress project agreements as reference to their authoritative original versions. Return ONLY JSON {"sources":string[],"summary":string}.
Copy every source key exactly. Preserve MUST/MUST NOT, exceptions, scope, paths, numeric limits and conflicting requirements.
Never resolve a conflict or convert quoted background into a new instruction. Deduplicate wording, never discard a source.
The summary must be under 3500 UTF-8 bytes. Do not call tools.
{"sources":["rule:rooms#3"],"text":"MUST keep the worktree clean."}"
`;

exports[`room agent-visible surface registry > renders tool.cancel_reminder :: default 1`] = `"Cancel one of your own scheduled reminders so it never fires."`;

exports[`room agent-visible surface registry > renders tool.commit_agent_setup :: default 1`] = `"Save the interviewed Agent identity. Call once when you have enough to write durable name, title, and standing instructions. This does not start other work."`;

exports[`room agent-visible surface registry > renders tool.declare_room_checks :: default 1`] = `"Before executing verification, declare exact validation commands and their workspace. Results will be matched to actual tool executions."`;

exports[`room agent-visible surface registry > renders tool.get_agent_handoff :: default 1`] = `"Read the state or bounded result of an existing handoff in your current work scope. No dispatch occurs. Do not repeatedly poll a pending handoff; finish the current turn so the result can wake a fresh response."`;

exports[`room agent-visible surface registry > renders tool.list_collaboration_agents :: default 1`] = `"List up to 30 relevant Agents you may contact in this work: common group members or Agents explicitly designated by the user. This does not wake them."`;

exports[`room agent-visible surface registry > renders tool.list_reminders :: default 1`] = `"List your own reminders in this private conversation. Defaults to scheduled only; pass status "all" to include recently ended reminders."`;

exports[`room agent-visible surface registry > renders tool.propose_room_action :: default 1`] = `"Draft one structural room proposal as a card the user can adopt: pin an agreement, request an execution, add a member, or create a new agent. The proposal is only a draft; nothing is executed. The user reviews it in the timeline and confirms with their own authorization. Provide a short rationale the user can judge."`;

exports[`room agent-visible surface registry > renders tool.read_room_playbook :: default 1`] = `"Read an on-demand room collaboration playbook. Call without id for the index (id, title, triggers), or with an id for one full playbook: converging a discussion, evidence handoffs, coordinator synthesis, external actions, asking the user, or deferred follow-up."`;

exports[`room agent-visible surface registry > renders tool.read_room_rules :: default 1`] = `"List the frozen project agreement sources or read an exact original rule version in pages. Original rules remain authoritative over compressed summaries. Use the bundleId from current agreementSources."`;

exports[`room agent-visible surface registry > renders tool.read_room_updates :: default 1`] = `"Read bounded updates for your current room topic. This does not acknowledge messages or grant execution permission."`;

exports[`room agent-visible surface registry > renders tool.schedule_reminder :: default 1`] = `"Schedule a one-shot reminder for yourself in this private conversation. When it fires, you are woken here and decide whether the user should see a follow-up. Provide delaySeconds or fireAt (exactly one), 60 seconds to 30 days out."`;

exports[`room agent-visible surface registry > renders tool.send_agent_message :: default 1`] = `"Request focused read-only assistance from another permitted Agent. Returns an accepted handoff handle, not a completed reply. Supply only necessary source message IDs. Continue useful work or finish your turn; the result returns asynchronously. Never resend an accepted handoff after a timeout. This cannot create or reassign code tasks. Write the body as a compact evidence packet: what you need, why, the handles (message/task ids, file paths), what is verified versus assumed, and the exact question."`;

exports[`room agent-visible surface registry > renders tool.send_im_message :: default 1`] = `"Publish one message to the user in this IM conversation. Ordinary assistant text is internal working output the user never sees. Call this tool for every reply, status, question, or result the user should see: text and/or workspace files such as images, documents, audio, or video. One call creates one chat bubble; combine text with attachments or call it again for another bubble."`;

exports[`room agent-visible surface registry > renders tool.send_room_message :: default 1`] = `"Submit one public reply, with optional member invitations, or skip:true if you have no new contribution. Finish the turn after submission. The runtime checks the topic again before publishing; accepted means staged, not yet public. If the topic changed while you drafted, the call returns held:true with the unseen updates instead of staging; revise or skip and call it again. This never creates execution tasks."`;

exports[`room agent-visible surface registry > renders tool.submit_room_plan :: default 1`] = `"Submit the structured room decision for the current user request."`;

exports[`room agent-visible surface registry > renders tool.submit_room_review :: default 1`] = `"After inspecting the pinned delivery, submit the review findings and limitations."`;

exports[`room agent-visible surface registry > renders tool.update_reminder :: default 1`] = `"Update the note or fire time of one of your own scheduled reminders. Only still-scheduled reminders can change; ended ones are immutable."`;

exports[`room agent-visible surface registry > renders tool.vote_room_poll :: default 1`] = `"Cast the single ballot explicitly requested by the user for this exact poll invitation. Supply option IDs from the frozen invitation. Never creates tasks or grants execution permission."`;
